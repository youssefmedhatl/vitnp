{
  "name": "vitality-customer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vitality \u2014 customer storefront (Supabase, cash-only)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:hooks": "eslint src --quiet --rule \"{\\\"react-hooks/rules-of-hooks\\\":\\\"error\\\"}\"",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/lib/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
