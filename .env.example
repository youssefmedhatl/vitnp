# ---------------------------------------------------------------------------
# Vitality — environment
# Copy this file to `.env` and fill in the two values from your Supabase project
# (Supabase dashboard -> Project Settings -> API)
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose in the browser — every table is
# protected by Row Level Security. NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Optional: store defaults used before the settings row is loaded
VITE_DEFAULT_LOCALE=ar
VITE_DEFAULT_CURRENCY=EGP
